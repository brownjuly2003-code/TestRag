    {
      "parameters": {
        "jsCode": "const escapeHtml = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst seenFiles = new Set();\nconst dedupedSources = [];\nfor (const s of ($json.sources || [])) {\n  const file = s.file || s.chunk_id || '';\n  if (file && seenFiles.has(file)) continue;\n  seenFiles.add(file);\n  dedupedSources.push(s);\n}\nconst sources = dedupedSources.map((s, i) => {\n  const file = escapeHtml(s.file || s.chunk_id || 'unknown');\n  const section = escapeHtml(s.section || 'раздел не указан');\n  return `${i + 1}. <code>${file}</code> (${section}, score ${s.score})`;\n}).join('\\n');\nconst count = dedupedSources.length;\nconst pluralRu = (n) => {\n  const mod10 = n % 10;\n  const mod100 = n % 100;\n  if (mod10 === 1 && mod100 !== 11) return 'релевантный документ';\n  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return 'релевантных документа';\n  return 'релевантных документов';\n};\nconst summary = count > 0 ? `Найдено ${count} ${pluralRu(count)}.` : 'По базе знаний не найдено подходящих документов.';\nconst answer = escapeHtml($json.answer);\nconst text = `${answer}\\n\\n${summary}${sources ? `\\n\\nИсточники:\\n${sources}` : ''}`;\nreturn [{ json: { chat_id: $node['Whitelist'].json.chat_id, text, request_log_id: $json.request_log_id || '' } }];"
      },
