    {
      "parameters": {
        "jsCode": "const escapeHtml = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst pluralRu = (n) => {\n  const mod10 = n % 10;\n  const mod100 = n % 100;\n  if (mod10 === 1 && mod100 !== 11) return ['Последний', 'запрос'];\n  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return ['Последние', 'запроса'];\n  return ['Последние', 'запросов'];\n};\nconst items = ($json.items || []);\nif (!items.length) {\n  return [{ json: { chat_id: $node['Whitelist'].json.chat_id, text: 'История запросов пуста. Задайте первый вопрос — он попадёт в /history.' } }];\n}\nconst lines = items.map((it, i) => {\n  const q = escapeHtml(it.question || '').slice(0, 120);\n  const when = (it.created_at || '').slice(0, 16).replace('T', ' ');\n  const tag = it.refused ? ' [отказ]' : '';\n  return `${i + 1}. <b>${when}</b>${tag}\\n   <code>${q}</code>`;\n}).join('\\n\\n');\nconst [prefix, noun] = pluralRu(items.length);\nconst text = `<b>${prefix} ${items.length} ${noun}:</b>\\n\\n${lines}`;\nreturn [{ json: { chat_id: $node['Whitelist'].json.chat_id, text } }];"
      },
