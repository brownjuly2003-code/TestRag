{
  "name": "TestRag HR Legal Assistant",
  "id": "testrag-hr-legal-assistant",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ],
        "additionalFields": {}
      },
      "id": "telegram-trigger",
      "name": "TelegramTrigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.3,
      "position": [
        -720,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "testrag-telegram-api",
          "name": "TestRag Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const allowed = ($env.ALLOWED_TELEGRAM_USER_IDS || '').split(',').map(v => v.trim()).filter(Boolean);\nconst callbackData = $json.callback_query?.data || '';\nconst feedbackParts = callbackData.startsWith('feedback:') ? callbackData.split(':') : [];\nconst isFeedback = feedbackParts.length >= 2;\nconst message = $json.message || $json.callback_query?.message || {};\nconst from = $json.message?.from || $json.callback_query?.from || {};\nconst userId = String(from.id || '');\nif (!allowed.length) {\n  return [{ json: { authorized: false, chat_id: message.chat?.id, user_id: userId, text: `Whitelist не настроен. Ваш Telegram ID: ${userId}. Добавьте его в ALLOWED_TELEGRAM_USER_IDS в локальном .env и перезапустите n8n.` } }];\n}\nif (!allowed.includes(userId)) {\n  return [{ json: { authorized: false, chat_id: message.chat?.id, user_id: userId, text: `Доступ запрещен. Ваш Telegram ID: ${userId}.` } }];\n}\nreturn [{ json: { authorized: true, event_type: isFeedback ? 'feedback' : 'question', chat_id: message.chat?.id, user_id: userId, text: message.text || callbackData || '', rating: isFeedback ? feedbackParts[1] : null, request_log_id: isFeedback ? (feedbackParts[2] || null) : null } }];"
      },
      "id": "whitelist",
      "name": "Whitelist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -500,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.authorized }}",
              "value2": true
            }
          ]
        }
      },
      "id": "authorized-if",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -280,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.event_type }}",
              "value2": "feedback"
            }
          ]
        }
      },
      "id": "feedback-if",
      "name": "Feedback?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -40,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RAG_API_URL }}/ask",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ question: $json.text, telegram_user_id: $json.user_id, top_k: 5 }) }}",
        "options": {}
      },
      "id": "ask-rag",
      "name": "Ask RAG API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        180,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RAG_API_URL }}/feedback",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ request_log_id: $json.request_log_id, telegram_user_id: $json.user_id, rating: $json.rating, comment: 'telegram_inline_button' }) }}",
        "options": {}
      },
      "id": "send-feedback",
      "name": "Send Feedback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        180,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const sources = ($json.sources || []).map((s, i) => `${i + 1}. ${s.file || s.chunk_id} (${s.section || 'раздел не указан'}, score ${s.score})`).join('\\n');\nconst text = `${$json.answer}\\n\\nConfidence: ${$json.confidence}\\n${sources ? `\\nИсточники:\\n${sources}` : ''}`;\nreturn [{ json: { chat_id: $node['Whitelist'].json.chat_id, text, request_log_id: $json.request_log_id || '' } }];"
      },
      "id": "format-answer",
      "name": "Format Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { chat_id: $node['Whitelist'].json.chat_id, text: 'Оценка принята.' } }];"
      },
      "id": "format-feedback",
      "name": "Format Feedback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        120
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "replyMarkup": "inlineKeyboard",
          "inlineKeyboard": {
            "rows": [
              {
                "row": {
                  "buttons": [
                    {
                      "text": "Good",
                      "additionalFields": {
                        "callback_data": "={{ 'feedback:good:' + ($json.request_log_id || '') }}"
                      }
                    },
                    {
                      "text": "Bad",
                      "additionalFields": {
                        "callback_data": "={{ 'feedback:bad:' + ($json.request_log_id || '') }}"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "id": "send-answer",
      "name": "Send Answer",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        -120
      ],
      "credentials": {
        "telegramApi": {
          "id": "testrag-telegram-api",
          "name": "TestRag Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}"
      },
      "id": "send-feedback-ack",
      "name": "Send Feedback Ack",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        120
      ],
      "credentials": {
        "telegramApi": {
          "id": "testrag-telegram-api",
          "name": "TestRag Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}"
      },
      "id": "send-denied",
      "name": "Send Denied",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        -40,
        120
      ],
      "credentials": {
        "telegramApi": {
          "id": "testrag-telegram-api",
          "name": "TestRag Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "TelegramTrigger": {
      "main": [
