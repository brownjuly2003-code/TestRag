    {
      "parameters": {
        "jsCode": "const allowed = ($env.ALLOWED_TELEGRAM_USER_IDS || '').split(',').map(v => v.trim()).filter(Boolean);\nconst callbackData = $json.callback_query?.data || '';\nconst feedbackParts = callbackData.startsWith('feedback:') ? callbackData.split(':') : [];\nconst isFeedback = feedbackParts.length >= 2;\nconst message = $json.message || $json.callback_query?.message || {};\nconst from = $json.message?.from || $json.callback_query?.from || {};\nconst messageId = $json.callback_query?.message?.message_id || null;\nconst userId = String(from.id || '');\nconst rawText = message.text || callbackData || '';\nconst normalizedText = rawText.trim().toLowerCase().replace(/ё/g, 'е').replace(/[.!?,]+$/g, '');\nconst greetingText = 'Здравствуйте. Я HR/legal RAG-ассистент TestRag. Задайте вопрос по кадровым, юридическим или договорным документам, а я отвечу по базе знаний и покажу источники.';\nconst REASON_KEYS = ['inaccurate', 'outdated', 'human'];\nlet eventType = isFeedback ? 'feedback' : 'question';\nlet text = rawText;\nlet rating = null;\nlet category = null;\nlet requestLogId = null;\nif (isFeedback) {\n  const verb = feedbackParts[1] || '';\n  requestLogId = feedbackParts[2] || null;\n  if (verb === 'good') {\n    rating = 'good';\n  } else if (verb === 'bad') {\n    eventType = 'feedback_bad_clarify';\n    rating = null;\n  } else if (verb.startsWith('bad_')) {\n    const reasonKey = verb.slice(4);\n    if (REASON_KEYS.includes(reasonKey)) {\n      rating = 'bad';\n      category = reasonKey;\n    } else {\n      eventType = 'direct_reply';\n      text = 'Неизвестная причина обратной связи.';\n    }\n  } else {\n    eventType = 'direct_reply';\n    text = 'Неизвестная команда обратной связи.';\n  }\n}\nif (!isFeedback && !normalizedText) {\n  eventType = 'direct_reply';\n  text = 'Пока я понимаю только текстовые вопросы. Задайте вопрос по HR, юридическим или договорным документам одним сообщением.';\n}\nif (!isFeedback && ['привет', 'здравствуйте', 'добрый день', 'доброе утро', 'добрый вечер', 'hello', 'hi', '/start', 'start'].includes(normalizedText)) {\n  eventType = 'direct_reply';\n  text = greetingText;\n}\nif (!isFeedback && ['спасибо', 'благодарю'].includes(normalizedText)) {\n  eventType = 'direct_reply';\n  text = 'Пожалуйста. Если нужен разбор по HR/legal документам, задайте вопрос одним сообщением.';\n}\nif (!allowed.length) {\n  return [{ json: { authorized: false, chat_id: message.chat?.id, user_id: userId, text: `Whitelist не настроен. Ваш Telegram ID: ${userId}. Добавьте его в ALLOWED_TELEGRAM_USER_IDS в локальном .env и перезапустите n8n.` } }];\n}\nif (!allowed.includes(userId)) {\n  return [{ json: { authorized: false, chat_id: message.chat?.id, user_id: userId, text: `Доступ запрещен. Ваш Telegram ID: ${userId}.` } }];\n}\nreturn [{ json: { authorized: true, event_type: eventType, chat_id: message.chat?.id, message_id: messageId, user_id: userId, text, rating, category, request_log_id: requestLogId } }];"
      },
