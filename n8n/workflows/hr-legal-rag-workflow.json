{
  "name": "TestRag HR Legal Assistant",
  "id": "testrag-hr-legal-assistant",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ],
        "additionalFields": {}
      },
      "id": "telegram-trigger",
      "name": "TelegramTrigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.3,
      "position": [
        -720,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "testrag-telegram-api",
          "name": "TestRag Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const allowed = ($env.ALLOWED_TELEGRAM_USER_IDS || '').split(',').map(v => v.trim()).filter(Boolean);\nconst callbackData = $json.callback_query?.data || '';\nconst feedbackParts = callbackData.startsWith('feedback:') ? callbackData.split(':') : [];\nconst isFeedback = feedbackParts.length >= 2;\nconst message = $json.message || $json.callback_query?.message || {};\nconst from = $json.message?.from || $json.callback_query?.from || {};\nconst userId = String(from.id || '');\nconst rawText = message.text || callbackData || '';\nconst normalizedText = rawText.trim().toLowerCase().replace(/ё/g, 'е').replace(/[.!?,]+$/g, '');\nconst greetingText = 'Здравствуйте. Я HR/legal RAG-ассистент TestRag. Задайте вопрос по кадровым, юридическим или договорным документам, а я отвечу по базе знаний и покажу источники.';\nlet eventType = isFeedback ? 'feedback' : 'question';\nlet text = rawText;\nif (!isFeedback && !normalizedText) {\n  eventType = 'direct_reply';\n  text = 'Пока я понимаю только текстовые вопросы. Задайте вопрос по HR, юридическим или договорным документам одним сообщением.';\n}\nif (!isFeedback && ['привет', 'здравствуйте', 'добрый день', 'доброе утро', 'добрый вечер', 'hello', 'hi', '/start', 'start'].includes(normalizedText)) {\n  eventType = 'direct_reply';\n  text = greetingText;\n}\nif (!isFeedback && ['спасибо', 'благодарю'].includes(normalizedText)) {\n  eventType = 'direct_reply';\n  text = 'Пожалуйста. Если нужен разбор по HR/legal документам, задайте вопрос одним сообщением.';\n}\nif (!allowed.length) {\n  return [{ json: { authorized: false, chat_id: message.chat?.id, user_id: userId, text: `Whitelist не настроен. Ваш Telegram ID: ${userId}. Добавьте его в ALLOWED_TELEGRAM_USER_IDS в локальном .env и перезапустите n8n.` } }];\n}\nif (!allowed.includes(userId)) {\n  return [{ json: { authorized: false, chat_id: message.chat?.id, user_id: userId, text: `Доступ запрещен. Ваш Telegram ID: ${userId}.` } }];\n}\nreturn [{ json: { authorized: true, event_type: eventType, chat_id: message.chat?.id, user_id: userId, text, rating: isFeedback ? feedbackParts[1] : null, request_log_id: isFeedback ? (feedbackParts[2] || null) : null } }];"
      },
      "id": "whitelist",
      "name": "Whitelist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -500,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ String($json.authorized) }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "authorized-if",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -280,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.event_type }}",
              "rightValue": "feedback",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "feedback-if",
      "name": "Feedback?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -40,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RAG_API_URL }}/ask",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ question: $json.text, telegram_user_id: $json.user_id, top_k: 5 }) }}",
        "options": {}
      },
      "id": "ask-rag",
      "name": "Ask RAG API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        180,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RAG_API_URL }}/feedback",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ request_log_id: $json.request_log_id, telegram_user_id: $json.user_id, rating: $json.rating, comment: 'telegram_inline_button' }) }}",
        "options": {}
      },
      "id": "send-feedback",
      "name": "Send Feedback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        180,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.event_type }}",
              "rightValue": "direct_reply",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "direct-reply-if",
      "name": "Direct Reply?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        180,
        -120
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "send-direct-reply",
      "name": "Send Direct Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        420,
        -240
      ],
      "credentials": {
        "telegramApi": {
          "id": "testrag-telegram-api",
          "name": "TestRag Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const escapeUnderscores = (s) => String(s == null ? '' : s).replace(/_/g, '\\_');\nconst seenFiles = new Set();\nconst dedupedSources = [];\nfor (const s of ($json.sources || [])) {\n  const file = s.file || s.chunk_id || '';\n  if (file && seenFiles.has(file)) continue;\n  seenFiles.add(file);\n  dedupedSources.push(s);\n}\nconst sources = dedupedSources.map((s, i) => {\n  const file = escapeUnderscores(s.file || s.chunk_id || 'unknown');\n  const section = escapeUnderscores(s.section || 'раздел не указан');\n  return `${i + 1}. ${file} (${section}, score ${s.score})`;\n}).join('\n');\nconst text = `${$json.answer}\n\nConfidence: ${$json.confidence}\n${sources ? `\nИсточники:\n${sources}` : ''}`;\nreturn [{ json: { chat_id: $node['Whitelist'].json.chat_id, text, request_log_id: $json.request_log_id || '' } }];"
      },
      "id": "format-answer",
      "name": "Format Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { chat_id: $node['Whitelist'].json.chat_id, text: 'Оценка принята.' } }];"
      },
      "id": "format-feedback",
      "name": "Format Feedback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        120
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false
        },
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "👍 Полезно",
                    "additionalFields": {
                      "callback_data": "={{ 'feedback:good:' + ($json.request_log_id || '') }}"
                    }
                  },
                  {
                    "text": "👎 Неточно",
                    "additionalFields": {
                      "callback_data": "={{ 'feedback:bad:' + ($json.request_log_id || '') }}"
                    }
                  },
                  {
                    "text": "📋 Нужны источники",
                    "additionalFields": {
                      "callback_data": "={{ 'feedback:sources:' + ($json.request_log_id || '') }}"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "send-answer",
      "name": "Send Answer",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        -120
      ],
      "credentials": {
        "telegramApi": {
          "id": "testrag-telegram-api",
          "name": "TestRag Telegram Bot"
        }
      }
    },
