      "parameters": {
        "jsCode": "const escapeHtml = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst cats = ($json.categories || []);\nconst total = $json.total_docs || 0;\nif (!cats.length) {\n  return [{ json: { chat_id: $node['Whitelist'].json.chat_id, text: 'Корпус пуст или не загружен.' } }];\n}\nconst lines = cats.map(c => {\n  const samples = (c.sample_files || []).slice(0, 2).map(f => `<code>${escapeHtml(f)}</code>`).join(', ');\n  const tail = samples ? ` — например ${samples}` : '';\n  return `• <b>${escapeHtml(c.label)}</b> (${c.doc_count})${tail}`;\n}).join('\\n');\nconst text = `<b>Корпус знаний: ${total} документов</b>\\n\\n${lines}\\n\\n<i>Задайте вопрос по любой категории — ассистент найдёт релевантные документы и сошлётся на конкретные разделы.</i>`;\nreturn [{ json: { chat_id: $node['Whitelist'].json.chat_id, text } }];\n"
      },
